# Copie para .env e preencha. O .env local aponta SEMPRE para o projeto Supabase de TESTE.
# Chaves de PRODUÇÃO não ficam em máquina local: vão direto para o Secret Manager do GCP.

# --- Supabase (projeto TESTE) ---
SUPABASE_URL=
SUPABASE_PROJECT_REF=
# Chaves no formato novo (sb_publishable_ / sb_secret_)
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Chaves legadas (JWT) — manter enquanto houver uso
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Chaves públicas para validar o JWT do login na API (sem segredo compartilhado)
SUPABASE_JWKS_URL=
# Connection string do Postgres (Settings > Database). Usada para migrations.
SUPABASE_DB_URL=

# --- Fontes de dados ---
BRAPI_TOKEN=

# --- IA (camada de explicação) via OpenRouter ---
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=

# --- Alertas ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- API: UUID(s) de usuário autorizados, separados por vírgula (vazio = ninguém) ---
ALLOWED_USER_IDS=
