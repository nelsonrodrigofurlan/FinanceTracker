# Copie para .env.local. Somente valores PÚBLICOS — nunca a chave secreta do Supabase.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
API_URL=http://localhost:8000
# UUID(s) de usuário autorizados, separados por vírgula (vazio = ninguém)
ALLOWED_USER_IDS=
# Somente no Cloud Run: URL da API (audience do ID token). Vazio em desenvolvimento local.
API_AUDIENCE=
